# Copy to .streamlit/secrets.toml for local runs, or set the same keys as
# environment variables / Streamlit Community Cloud secrets.
#
# Pilot-grade auth: ONE shared credential for all reviewers.
# Phase 2 replaces this entirely with Entra ID SSO.
AUTH_USER = "vpc"
AUTH_PASS = "change-me"

# Domain the reviewer's email must belong to (case-insensitive).
ALLOWED_EMAIL_DOMAIN = "vodafone.com"

# The people invited to use the app. Mirror the viewer allowlist you set in the
# app's Community Cloud settings. Anyone not on this list is turned away at
# sign-in with a message pointing them at ACCESS_CONTACT. Leave unset to keep
# the app open to every address on the domain above.
# (The older name REVIEWER_EMAILS is still honoured, so an existing deployment
# keeps working without an edit.)
ALLOWED_EMAILS = "first.person@vodafone.com, second.person@vodafone.com"

# Named in the "you're not authorised" message.
ACCESS_CONTACT = "Praveen"

# Governance is open to every invited reviewer -- seeing the RBAC queue is part
# of what the pilot asks people to review, so there is no separate admin list.

# --- Identity ------------------------------------------------------------
# false: the app runs its own shared sign-in, and the stage QR hands out guest
#        access from a signed link (see below).
# true:  the hosting environment authenticates the visitor. The app adopts that
#        identity, the stage QR drops its token, and previously photographed
#        codes stop working. Flip this when AI Booster SSO is in place; the
#        one place that may need adapting is _sso_sign_in in foundry/auth.py,
#        depending on whether identity arrives via OIDC or a proxy header.
SSO = "false"

# --- Guest access for the All Hands --------------------------------------
# Signing key for the stage QR token. Unset means guest access is off entirely,
# which is the safe default. Use a long random string, and change it after the
# event to invalidate every link handed out on the day.
#
# A guest can browse Explore, the Library and the Leaderboard, and vote.
# Submit, Governance and access requests still need an ordinary sign-in.
#
# The token is a bearer credential in a URL: anyone in the room can photograph
# the screen. That is the trade being made for an event, and the reason it
# expires on its own.
EVENT_SECRET = "generate-a-long-random-string"

# How long a scanned link stays valid. Long enough for one session.
GUEST_TOKEN_HOURS = "4"
