# Copy to .streamlit/secrets.toml for local runs, or set the same keys as
# environment variables / Streamlit Community Cloud secrets.
#
# Pilot-grade auth: ONE shared credential for all reviewers.
# Phase 2 replaces this entirely with Entra ID SSO.
AUTH_USER = "vpc"
AUTH_PASS = "change-me"

# Domain the reviewer's email must belong to (case-insensitive).
ALLOWED_EMAIL_DOMAIN = "vodafone.com"

# The people invited to review the pilot. Mirror the viewer allowlist you set
# in the app's Community Cloud settings. Anyone not on this list is turned away
# at sign-in with a message pointing them at ACCESS_CONTACT. Leave unset to keep
# the pilot open to every address on the domain above.
REVIEWER_EMAILS = "first.reviewer@vodafone.com, second.reviewer@vodafone.com"

# Named in the "you're not authorised" message.
ACCESS_CONTACT = "Praveen"

# Governance is open to every invited reviewer -- seeing the RBAC queue is part
# of what the pilot asks people to review, so there is no separate admin list.

# --- Durable feedback storage -------------------------------------------
# Reviewer feedback is filed as a GitHub issue so it survives the app sleeping
# or redeploying. Use a fine-grained token with Issues: read & write on the
# repo below. Without these the feedback UI still works, but writes only to
# data/feedback.json and is lost on restart.
#
# The repository MUST be private before using this for real: issues on a public
# repo are world-readable, and candid reviewer feedback is not.
GITHUB_TOKEN = "github_pat_..."
GITHUB_REPO = "porvakanti/foundry"
