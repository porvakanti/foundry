# Copy to .streamlit/secrets.toml for local runs, or set the same keys as
# environment variables / Streamlit Community Cloud secrets.
#
# Pilot-grade auth: ONE shared credential for all reviewers.
# Phase 2 replaces this entirely with Entra ID SSO.
AUTH_USER = "vpc"
AUTH_PASS = "change-me"

# Domain the reviewer's email must belong to (case-insensitive).
ALLOWED_EMAIL_DOMAIN = "vodafone.com"

# The people invited to use the app. Mirror the viewer allowlist you set in the
# app's Community Cloud settings. Anyone not on this list is turned away at
# sign-in with a message pointing them at ACCESS_CONTACT. Leave unset to keep
# the app open to every address on the domain above.
# (The older name REVIEWER_EMAILS is still honoured, so an existing deployment
# keeps working without an edit.)
ALLOWED_EMAILS = "first.person@vodafone.com, second.person@vodafone.com"

# Named in the "you're not authorised" message.
ACCESS_CONTACT = "Praveen"

# Governance is open to every invited reviewer -- seeing the RBAC queue is part
# of what the pilot asks people to review, so there is no separate admin list.

# --- Durable feedback storage -------------------------------------------
# Feedback is filed as a GitHub issue so it survives the app sleeping or
# redeploying. Without these two keys the feedback UI still works, but writes
# only to data/feedback.json and is lost on restart. Governance shows which of
# the two states you are in, and has a Test connection button.
#
# Order matters if you are also making the repository private. Do it in this
# order or the app can lose access to its own source:
#
#   1. Grant Community Cloud the wider GitHub scope FIRST. Private repos need
#      an OAuth scope beyond the public default; without it the next redeploy
#      fails with "You do not have access to this app or it does not exist".
#      If that happens: github.com/settings/applications, revoke Streamlit,
#      then sign in to Community Cloud again to be re-prompted.
#   2. Flip the repository to private.
#   3. Create a fine-grained token: repository access limited to this repo,
#      permission Issues: read & write. Nothing else is needed.
#   4. Paste both keys below, then press Test connection on Governance.
#
# Issues on a PUBLIC repo are world-readable, so feedback is only as private as
# the repository it is filed into.
GITHUB_TOKEN = "github_pat_..."
GITHUB_REPO = "porvakanti/foundry"
